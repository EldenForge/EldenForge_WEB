# Base URL de l'API EldenForge
VITE_API_BASE_URL=http://localhost:8000

# Sentry (optionnel en dev local, vide = capture desactivee)
# Cote client : DSN du projet eldenforge-web (Settings > Client Keys).
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=dev

# Cote server-side hooks (hooks.server.ts) : meme DSN generalement.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# Sourcemaps upload (uniquement pour builds prod/recette).
# SENTRY_AUTH_TOKEN=xxx    # secret GitHub, jamais commit
# SENTRY_ORG=eldenforge
# SENTRY_PROJECT=eldenforge-web

# Playwright E2E : URL de test (optionnel, defaut http://localhost:5173)
# PLAYWRIGHT_BASE_URL=http://localhost:5173
